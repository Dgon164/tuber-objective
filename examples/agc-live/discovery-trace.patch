 int CoverageCounts = 0;			// Increment coverage counts is != 0.
+
+// ---- discovery trace (added for Project Discovery; see agc-test/README.md) ----
+// Two optional trace files, opened from environment variables:
+//   AGC_TRACE_WRITES    every write to erasable memory, 10 bytes big-endian:
+//                       instruction address (0..36863, same index as the rope),
+//                       instruction word, erasable address (0..4095),
+//                       old value, new value
+//   AGC_TRACE_CHANNELS  every output-channel packet, 4 bytes, as sent on the socket,
+//                       and every input-channel packet received, same form
+#include <stdlib.h>
+FILE *TraceWrites = NULL;
+FILE *TraceChannels = NULL;
+static uint16_t TraceInstrAddr = 0, TraceInstrWord = 0;
+static void
+TraceOpen (void)
+{
+  static int done = 0;
+  char *p;
+  if (done) return;
+  done = 1;
+  if ((p = getenv ("AGC_TRACE_WRITES")) != NULL) TraceWrites = fopen (p, "wb");
+  if ((p = getenv ("AGC_TRACE_CHANNELS")) != NULL) TraceChannels = fopen (p, "wb");
+}
+static void
+TracePut16 (FILE *f, uint16_t v)
+{
+  fputc ((v >> 8) & 0xff, f);
+  fputc (v & 0xff, f);
+}
+// ---- end discovery trace ----
 unsigned ErasableReadCounts[8][0400];
 unsigned ErasableWriteCounts[8][0400];
 unsigned ErasableInstructionCounts[8][0400];
